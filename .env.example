# Django core
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com

# CORS
DJANGO_CORS_ALLOW_ALL_ORIGINS=false
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com

# Database (defaults to SQLite if DATABASE_URL is empty)
# Production: postgres://user:password@localhost:5432/kakucraft
DATABASE_URL=

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# DRF throttling
DRF_THROTTLE_ANON=100/hour
DRF_THROTTLE_USER=1000/hour

# Security headers
DJANGO_SECURE_HSTS_SECONDS=31536000

# Uploads
DJANGO_UPLOAD_MAX_MEMORY=5242880

# Async / realtime
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Email / SMTP (Option A: Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Kaku Craft <noreply@kakucraft.com>

# Logging
DJANGO_LOG_LEVEL=INFO
